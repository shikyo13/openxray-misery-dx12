// Final scene transfer and legacy camera PPE. Exposure/ACES remain inactive.
Texture2D t_hdr : register(t0);
Texture2D t_pp_noise : register(t1);
Texture2D t_pp_grad0 : register(t2);
Texture2D t_pp_grad1 : register(t3);

#include "common_samplers.h"

cbuffer PostProcessParams : register(b0) {
    float4 pp_color_base; // RGB tint, inverse noise blend
    float4 pp_color_gray; // grayscale weights, inverse gray blend
    float4 pp_color_add;
    float4 pp_duality_blur; // blur offset XY, half duality ZW
    float4 pp_noise_uv; // offset XY, scale ZW
    float4 pp_controls; // enabled, color-map influence, interpolation, reserved
};

struct PS_INPUT {
    float4 position : SV_POSITION;
    float2 texcoord : TEXCOORD0;
};

float4 main(PS_INPUT input) : SV_TARGET {
    // Preserve the existing neutral image without quantization or extra filtering.
    if (pp_controls.x == 0.0)
        return t_hdr.Sample(smp_linear, input.texcoord);

    float2 uv = input.texcoord * (1.0 - pp_duality_blur.zw) + pp_duality_blur.xy;
    float3 color = 0.5 * (t_hdr.Sample(smp_rtlinear, uv).rgb +
        t_hdr.Sample(smp_rtlinear, uv + pp_duality_blur.zw).rgb);

    if (pp_controls.y > 0.0) {
        float2 gradientUV = float2(dot(color, float3(0.3333, 0.3333, 0.3333)), 0.5);
        float3 mapped = lerp(t_pp_grad0.Sample(smp_rtlinear, gradientUV).rgb,
            t_pp_grad1.Sample(smp_rtlinear, gradientUV).rgb, pp_controls.z);
        color = lerp(color, mapped, pp_controls.y);
    }

    float gray = dot(color, pp_color_gray.rgb);
    color = lerp(float3(gray, gray, gray), color, pp_color_gray.a);
    if (pp_color_base.a < 1.0) {
        float3 noise = t_pp_noise.Sample(smp_linear,
            pp_noise_uv.xy + input.texcoord * pp_noise_uv.zw).rgb;
        color = lerp(color * noise * 2.0, color, pp_color_base.a);
    }
    color = (color * pp_color_base.rgb + pp_color_add.rgb) * 2.0;
    return float4(color, 1.0);
}
