 #pragma once
 #include "xrCore/Threading/ScopeLock.hpp"
+#include "xrCore/Threading/TaskManager.hpp"
+
+namespace graph_engine_trace
+{
+inline u64 begin()
+{
+    static const bool enabled = strstr(Core.Params, "-ai_path_trace") != nullptr;
+    return enabled ? CPU::QPC() : 0;
+}
+
+template <typename Graph>
+constexpr const char* kind()
+{
+    if constexpr (std::is_same_v<Graph, CLevelGraph>)
+        return "level";
+    else if constexpr (std::is_same_v<Graph, CGameGraph>)
+        return "game";
+    else
+        return "numeric";
+}
+
+inline void end(const char* kind, u64 start, u32 visited, size_t pathSize, bool success)
+{
+    if (!start)
+        return;
+    const u64 finish = CPU::QPC();
+    // Logging is outside the timed search. This diagnostic does not alter search limits,
+    // results, shared restriction masks or the existing callback execution order.
+    Msg("[AIPathTrace] kind=%s qpc_begin=%llu qpc_end=%llu qpc_freq=%llu worker=%zu visited=%u path_size=%zu success=%u duration_ms=%.6f",
+        kind, static_cast<unsigned long long>(start), static_cast<unsigned long long>(finish),
+        static_cast<unsigned long long>(CPU::qpc_freq), TaskManager::GetCurrentWorkerID(), visited,
+        pathSize, success ? 1u : 0u, double(finish - start) * 1000.0 / CPU::qpc_freq);
+}
+}
 
