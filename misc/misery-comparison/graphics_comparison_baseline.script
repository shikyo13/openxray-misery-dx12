-- Shared fixed-camera controller. Retail uses actor updates; DX12 uses main.
local stage = "init"
local next_time = 0
local case_index = 1
local finished = false
local cases = {
    {"interior", 128.80002, -7.34269, 177.79997, 9, "af3_day_clear"},
    {"outdoor", 164.53406, -5.55935, 152.64307, 9, "af3_day_clear"},
    {"rain", 164.53406, -5.55935, 152.64307, 9, "af3_day_rain"},
    {"night", 164.53406, -5.55935, 152.64307, 23, "af3_day_clear"}
}
local function emit(message)
    local row = string.format("%d|%s", time_global(), message):gsub("%s", "|")
    -- The retail console copies command names into a fixed-size buffer.
    assert(#row + #"comparison_event|" < 64, "comparison marker is too long")
    get_console():execute("comparison_event|" .. row)
    get_console():execute("flush")
end
local function step()
    if not db.actor or time_global() < next_time then return end
    local console = get_console()
    local item = cases[case_index]
    if stage == "init" then
        console:execute("main_menu off")
        device():pause(false)
        emit("loaded")
        stage = "place"; next_time = time_global() + 12000
        return
    elseif stage == "place" then
        level.set_time_factor(1)
        console:execute("hud_draw off")
        console:execute("hud_weapon off")
        local torch = db.actor:object("device_torch")
        if torch then torch:enable_torch(false) end
        if item[1] == "interior" then
            local minutes = (item[5]*60-level.get_time_hours()*60-level.get_time_minutes()+1440)%1440
            level.change_game_time(0, math.floor(minutes/60), minutes%60)
        elseif item[1] == "night" then
            level.change_game_time(0, (item[5]-level.get_time_hours()+24)%24, 0)
        end
        level.set_weather(item[6], true)
        db.actor:set_actor_position(vector():set(item[2], item[3], item[4]))
        stage = "camera"; next_time = time_global() + 6000
    elseif stage == "camera" then
        console:execute("demo_play graphics_comparison_" .. item[1])
        stage = "begin"; next_time = time_global() + 10000
    elseif stage == "begin" then
        emit("begin\t" .. item[1])
        emit(string.format("clock\t%d:%02d\t%s", level.get_time_hours(),level.get_time_minutes(),item[6]))
        local camera, direction = device().cam_pos, device().cam_dir
        emit(string.format("pos\t%.5f,%.5f,%.5f",camera.x,camera.y,camera.z))
        emit(string.format("dir\t%.5f,%.5f,%.5f",direction.x,direction.y,direction.z))
        emit(string.format("lens\t%.5f\t%.5f",device().fov,device().aspect_ratio))
        stage = "end"; next_time = time_global() + 30000
    elseif stage == "end" then
        emit("end\t" .. item[1])
        -- Retail reports command status for an empty argument instead of capturing.
        console:execute("screenshot comparison_" .. item[1])
        stage = "advance"; next_time = time_global() + 1500
    elseif stage == "advance" then
        case_index = case_index + 1
        if case_index > #cases then
            emit("complete"); finished = true; console:execute("quit")
        else
            stage = "place"
        end
    end
end
function update()
    if finished then return end
    local ok, err = pcall(step)
    if not ok then
        emit(("error\t" .. stage .. "\t" .. tostring(err)):sub(1,35))
        finished = true
        get_console():execute("quit")
    end
end
function main()
    while not finished do
        update()
        coroutine.yield()
    end
end
