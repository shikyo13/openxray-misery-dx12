-- One fresh-process, loaded-level check of the saved native quality preset.
local function wait_ms(ms)
    local until_time = time_global() + ms
    while time_global() < until_time do coroutine.yield() end
end
function main()
    while not db.actor do coroutine.yield() end
    wait_ms(8000)
    assert(device().width == 3440 and device().height == 1440)
    assert(get_console():get_string("r_aa") == "dlaa", "DLAA fell back or the saved setting did not load")
    assert(get_console():get_string("r_fsr_fg") == "0")
    assert(get_console():get_string("r2_smap_size") == "4096")
    assert(get_console():get_string("r_local_shadow_resolution") == "1024")
    assert(get_console():get_string("r2_ssao") == "st_opt_ultra")
    local file = assert(io.open("_appdata_/dx12_settings_level_probe.tsv", "wb"))
    file:write("loaded\t3440x1440\tDLAA\tsun4096\tlocal1024\tAO Ultra\tFG off\n")
    file:close()
    get_console():execute("screenshot")
    wait_ms(1200)
    _G.dx12_settings_open_loaded_menu = true
    get_console():execute("main_menu on")
end
