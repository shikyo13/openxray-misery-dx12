-- Bounded native observation of camera, authored NPC and first-person motion.
-- Uses the isolated runtime and one normal inventory action; no spawn/save/AI override.
local function wait_ms(ms)
    local finish=time_global()+ms
    while time_global()<finish do coroutine.yield() end
end
local function action(command, flags)
    -- Existing single-player inventory event, as used by the earlier HUD shot probe.
    local packet=net_packet()
    packet:w_begin(8);packet:w_u32(time_global());packet:w_u16(25)
    packet:w_u16(db.actor:id());packet:w_u16(command);packet:w_u32(flags)
    packet:w_s32(12345);packet:w_s32(54321)
    level.send(packet,true,true,false,true)
end
function main()
    while not db.actor do coroutine.yield() end
    wait_ms(12000)
    local weapon=assert(db.actor:active_item(),"Expected the loaded save's active weapon")
    assert(weapon:is_weapon())
    local weaponSlot=db.actor:active_slot()
    level.set_time_factor(1)
    level.change_game_time(0,(9-level.get_time_hours()+24)%24,0)
    level.set_weather("af3_day_clear",true)
    db.actor:activate_slot(0)
    local id=assert(get_story_object_id("zat_a2_stalker_barmen"))
    local anchor=alife():object(id).position
    local wanted=vector():set(anchor.x+5,anchor.y,anchor.z)
    local vertex=level.vertex_id(wanted)
    assert(level.valid_vertex(vertex))
    local position=level.vertex_position(vertex)
    assert(position:distance_to(wanted)<2)
    db.actor:set_actor_position(position)
    wait_ms(8000)
    local npc=assert(level.object_by_id(id))
    local root=npc:position()
    local aim=vector():set(root.x,root.y+1.2,root.z)
    local out=assert(io.open("_appdata_/dx12_local_shadow_probe.tsv","wb"))
    local function write(text) out:write(text.."\n");out:flush() end
    local cases={
        {"npc_scene","fxaa",0,false},
        {"npc_dlaa","dlaa",0,false},
        {"npc_quality","dlss_quality",0,false},
        {"weapon_scene","fxaa",3,false},
        {"weapon_dlaa","dlaa",3,false},
        {"weapon_quality","dlss_quality",3,true},
        {"weapon_balanced","dlss_balanced",3,false},
        {"weapon_performance","dlss_performance",3,false},
        {"weapon_shot","dlss_quality",3,false},
        {"rain_scene","dlss_quality",3,false},
        {"rain_fxaa","fxaa",3,false},
        {"rain_fxaa_fg","fxaa",3,true},
        {"rain_quality_reenabled","dlss_quality",3,true}
    }
    for _,case in ipairs(cases) do
        get_console():execute("r_fsr_fg "..((case[1]=="npc_scene" or case[1]=="weapon_scene" or case[1]=="rain_fxaa") and "0" or "1"))
        if case[1]=="rain_scene" then level.set_weather("af3_day_rain",true) end
        if case[1]=="weapon_scene" then
            wanted=vector():set(anchor.x+40,anchor.y,anchor.z-25)
            vertex=level.vertex_id(wanted)
            assert(level.valid_vertex(vertex))
            position=level.vertex_position(vertex)
            assert(position:distance_to(wanted)<3)
            db.actor:set_actor_position(position)
            wait_ms(6000)
            aim=vector():set(position.x+70,position.y+1.2,position.z+10)
        end
        get_console():execute("r_aa "..case[2])
        get_console():execute("r_motion_debug 0")
        get_console():execute("hud_draw "..(case[3]==3 and "on" or "off"))
        db.actor:activate_slot(case[3]==3 and weaponSlot or 0)
        local start=time_global()
        while time_global()-start<2500 do
            db.actor:actor_look_at_point(aim);coroutine.yield()
        end
        if case[3]==3 then
            local active=db.actor:active_item()
            assert(active and active:id()==weapon:id(),"Expected the original weapon equipped")
        end
        start=time_global()
        write(string.format("begin\t%s\t%d\t%d",case[1],start,device().frame))
        local captured=false
        local fired=false
        while time_global()-start<4800 do
            local offset=case[4] and math.sin((time_global()-start)*.0008)*1.0 or 0
            db.actor:actor_look_at_point(vector():set(aim.x,aim.y,aim.z+offset))
            if case[1]=="weapon_shot" and not fired and time_global()-start>=3900 then
                local before=weapon:get_ammo_in_magazine()
                assert(before>0)
                action(key_bindings.kWPN_FIRE,1)
                local deadline=time_global()+1000
                while weapon:get_ammo_in_magazine()==before and time_global()<deadline do coroutine.yield() end
                action(key_bindings.kWPN_FIRE,2)
                assert(weapon:get_ammo_in_magazine()==before-1,"Expected one real shot")
                write(string.format("weapon\t%s\tammo_before=%d\tammo_after=%d",weapon:section(),before,weapon:get_ammo_in_magazine()))
                wait_ms(35);fired=true
            end
            if not captured and time_global()-start>=4000 then
                position=db.actor:position()
                local head=assert(level.object_by_id(id)):bone_position("bip01_head")
                write(string.format("pose\t%s\t%d\t%d\t%.6f,%.6f,%.6f",case[1],time_global(),device().frame,head.x,head.y,head.z))
                write(string.format("end\t%s\t%d\t%d\t%.6f,%.6f,%.6f",case[1],time_global(),device().frame,position.x,position.y,position.z))
                get_console():execute("screenshot");captured=true
                local captures={npc_quality=1,weapon_quality=2,weapon_shot=3,rain_scene=4,rain_fxaa_fg=5,rain_quality_reenabled=6}
                if captures[case[1]] then get_console():execute("r_fsr_fg_capture "..captures[case[1]]) end
            end
            coroutine.yield()
        end
    end
    get_console():execute("r_motion_debug 0")
    get_console():execute("r_motion_debug_scale 1")
    level.set_weather("af3_day_clear",true)
    get_console():execute("r_aa fxaa")
    get_console():execute("r_fsr_fg 0")
    get_console():execute("r_fsr_fg_capture 0")
    write("complete");out:close()
    get_console():execute("quit")
end
